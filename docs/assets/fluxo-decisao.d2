direction = right

inicio: Diagnóstico via SSH {
  label: "Diagnóstico\nvia SSH"
  style: {
    fill: "#e3f2fd"
    stroke: "#1565c0"
    stroke-width: 2
  }
}

auditoria: Auditoria LPIC-1 {
  label: "Auditoria\nLPIC-1"
  style: {
    fill: "#e3f2fd"
    stroke: "#1565c0"
    stroke-width: 2
  }
}

playbook: Gerar Playbook {
  label: "Gerar\nPlaybook"
  style: {
    fill: "#fff3e0"
    stroke: "#e65100"
    stroke-width: 2
  }
}

validacao: Regras de Segurança {
  label: "Regras de\nSegurança\nansible-lint"
  style: {
    fill: "#fff3e0"
    stroke: "#e65100"
    stroke-width: 2
  }
}

hitl: HITL Gate {
  shape: diamond
  label: "HITL\nAprovação\nHumana"
  style: {
    fill: "#ffecb3"
    stroke: "#f9a825"
    stroke-width: 3
  }
}

simulacao: Simulação {
  label: "Simulação\n--check --diff"
  style: {
    fill: "#fff3e0"
    stroke: "#e65100"
    stroke-width: 2
  }
}

aplicacao: Aplicação Real {
  label: "Aplicação\nansible-playbook"
  style: {
    fill: "#e8f5e9"
    stroke: "#2e7d32"
    stroke-width: 2
  }
}

validacao_pos: Validação Pós-Aplicação {
  label: "Validação\nPós-Aplicação"
  style: {
    fill: "#e8f5e9"
    stroke: "#2e7d32"
    stroke-width: 2
  }
}

fim: Relatório Técnico {
  label: "Relatório\nTécnico"
  style: {
    fill: "#334155"
    stroke: "#1e293b"
    stroke-width: 2
  }
}

inicio -> auditoria
auditoria -> playbook
playbook -> validacao
validacao -> simulacao
simulacao -> hitl
hitl -> aplicacao
aplicacao -> validacao_pos
validacao_pos -> fim
