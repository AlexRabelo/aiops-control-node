# Arquitetura aiops-control-node — Diagrama D2
# Compilar com: d2 --theme=1 --layout=elk arch-d2.d2 arch-d2.svg

direction = right

services: Ansible {
  shape: cylinder
  label: "Control Node\nagents-lab\nUbuntu 26.04"
  style: {
    fill: "#f0f4f8"
    stroke: "#2c3e50"
    strokeWidth: 2
    fontSize: 14
    fontFamily: "Inter, -apple-system, sans-serif"
  }
}

managed: Managed Nodes {
  shape: group
  label: ""
  style: {
    fill: "#ffffff"
    stroke: "#2c3e50"
    strokeWidth: 1
    strokeDash: 4
  }

  ubuntu: Ubuntu {
    shape: rectangle
    label: "ubuntu\n:2220\nUbuntu 26.04"
    style: {
      fill: "#e3f2fd"
      stroke: "#1565c0"
      strokeWidth: 2
      fontSize: 12
      fontFamily: "Inter, -apple-system, sans-serif"
      rx: 8
      ry: 8
    }
  }

  agentslab: "agents-lab" {
    shape: rectangle
    label: "agents-lab\n:2230\nUbuntu 26.04"
    style: {
      fill: "#e3f2fd"
      stroke: "#1565c0"
      strokeWidth: 2
      fontSize: 12
      fontFamily: "Inter, -apple-system, sans-serif"
      rx: 8
      ry: 8
    }
  }

  rhel10: RHEL {
    shape: rectangle
    label: "rhel10\n:2240\nRHEL 10.2"
    style: {
      fill: "#fff3e0"
      stroke: "#e65100"
      strokeWidth: 2
      fontSize: 12
      fontFamily: "Inter, -apple-system, sans-serif"
      rx: 8
      ry: 8
    }
  }

  awslinux: AWS {
    shape: rectangle
    label: "awslinux\n:2250\nAmazon Linux 2023"
    style: {
      fill: "#fff8e1"
      stroke: "#f9a825"
      strokeWidth: 2
      fontSize: 12
      fontFamily: "Inter, -apple-system, sans-serif"
      rx: 8
      ry: 8
    }
  }

  centos10: CentOS {
    shape: rectangle
    label: "centos10\n:2260\nCentOS Stream 10"
    style: {
      fill: "#fce4ec"
      stroke: "#880e4f"
      strokeWidth: 2
      fontSize: 12
      fontFamily: "Inter, -apple-system, sans-serif"
      rx: 8
      ry: 8
    }
  }
}

hitl: "HITL\nGate" {
  shape: diamond
  label: "HITL\nAprovação\nHumana"
  style: {
    fill: "#ffecb3"
    stroke: "#f9a825"
    strokeWidth: 3
    fontSize: 12
    fontFamily: "Inter, -apple-system, sans-serif"
    rx: 10
    ry: 10
  }
}

loop: "Loop AIOps" {
  shape: rectangle
  label: "Loop AIOps\nDiagnóstico →\nAuditoria →\nValidação\n→ Aplicação"
  style: {
    fill: "#e8f5e9"
    stroke: "#2e7d32"
    strokeWidth: 2
    fontSize: 12
    fontFamily: "Inter, -apple-system, sans-serif"
    rx: 8
    ry: 8
  }
}

services -> managed
managed -> hitl
hitl -> loop
loop -> services
